# Mastodon - Environment Variables
# Copy to app.env and customize
# NOTE: Generate VAPID keys with: docker run --rm tootsuite/mastodon bundle exec rake mastodon:webpush:generate_vapid_key

# Timezone
TZ=America/New_York

# Host settings
BASE_HOST_NAME=mastodon.example.com

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=mastodon
DB_USER_NAME=mastodon
DB_USER_PASS=changeme_db_password

# Secrets (generate strong random values for production)
APP_SECRET_KEY=changeme_secret_key_min_32_chars
OTP_SECRET=changeme_otp_secret_min_64_chars_00000000000000
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=changeme_deterministic_key_32ch
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=changeme_key_derivation_salt_32c
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=changeme_primary_key_32_chars_00

# VAPID keys (generate with the command above)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Email (SMTP)
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=25
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@example.com
SMTP_AUTH_METHOD=none

# Elasticsearch
ES_USER=elastic
ES_PASS=changeme_elastic_password

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ALIAS_HOST=

# Sidekiq
SIDEKIQ_THREADS=5
SIDEKIQ_QUEUE=
