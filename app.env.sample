# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.
#
# Generate the VAPID keys with:
#   docker run --rm tootsuite/mastodon bundle exec rake mastodon:webpush:generate_vapid_key

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=mastodon.example.com

DB_CREATE_DATABASE_NAME=mastodon
DB_USER_NAME=mastodon
DB_USER_PASS=replace-with-a-random-password

APP_SECRET_KEY=replace-with-a-random-32-character-secret
APP_SECRET_TOKEN_64=replace-with-a-random-64-character-secret
APP_SECRET_TOKEN_32=replace-with-a-random-32-character-key
ENCRYPTION_KEY=replace-with-a-random-32-character-salt
SECURE_SECRET=replace-with-a-random-32-character-key

VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

ES_USER=elastic
ES_PASS=replace-with-a-random-password

EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=25
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
EMAIL_SERVER_MAIL_FROM=no-reply@mastodon.example.com
SMTP_AUTH_METHOD=none

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ALIAS_HOST=
